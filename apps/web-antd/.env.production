VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=https://mock-napi.vben.pro/api

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true

# 语音代理 Worker 地址（见 apps/tts-proxy）。上线前必须改成已部署的 Worker 地址，
# 留空则微软 Azure 语音源不可用，英文朗读退回系统语音。
VITE_TTS_PROXY_URL=
