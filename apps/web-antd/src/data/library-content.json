      "模块": "古诗花园",
      "正文": "鹅，鹅，鹅，\n曲项向天歌。\n白毛浮绿水，\n红掌拨清波。",
      "表情": "🦢"
    },
    {
      "ID": "poem-dengque",
      "作者": "王之涣",
      "名称": "登鹳雀楼",
      "启用": true,
      "模块": "古诗花园",
      "正文": "白日依山尽，\n黄河入海流。\n欲穷千里目，\n更上一层楼。",
      "表情": "🏯"
    },
    {
      "ID": "poem-minnong",
      "作者": "李绅",
      "名称": "悯农",
      "启用": true,
      "模块": "古诗花园",
      "正文": "锄禾日当午，\n汗滴禾下土。\n谁知盘中餐，\n粒粒皆辛苦。",
      "表情": "🌾"
    },
    {
      "ID": "poem-jiangxue",
      "作者": "柳宗元",
      "名称": "江雪",
      "启用": true,
      "模块": "古诗花园",
      "正文": "千山鸟飞绝，\n万径人踪灭。\n孤舟蓑笠翁，\n独钓寒江雪。",
      "表情": "❄️"
    },
    {
      "ID": "poem-hua",
      "作者": "王维",
      "名称": "画",
      "启用": true,
      "模块": "古诗花园",
      "正文": "远看山有色，\n近听水无声。\n春去花还在，\n人来鸟不惊。",
      "表情": "🖼️"
    },
    {
      "ID": "poem-xiaochi",
      "作者": "杨万里",
      "名称": "小池",
      "启用": true,
      "模块": "古诗花园",
      "正文": "泉眼无声惜细流，\n树阴照水爱晴柔。\n小荷才露尖尖角，\n早有蜻蜓立上头。",
      "表情": "🪷"
    },
    {
      "ID": "poem-cunju",
      "作者": "高鼎",
      "名称": "村居",
      "启用": true,
      "模块": "古诗花园",
      "正文": "草长莺飞二月天，\n拂堤杨柳醉春烟。\n儿童散学归来早，\n忙趁东风放纸鸢。",
      "表情": "🪁"
    },
    {
      "ID": "poem-pubu",
      "作者": "李白",
      "名称": "望庐山瀑布",
      "启用": true,
      "模块": "古诗花园",
      "正文": "日照香炉生紫烟，\n遥看瀑布挂前川。\n飞流直下三千尺，\n疑是银河落九天。",
      "表情": "⛰️"
    },
    {
      "ID": "poem-jueju",
      "作者": "杜甫",
      "名称": "绝句",
      "启用": true,
      "模块": "古诗花园",
      "正文": "两个黄鹂鸣翠柳，\n一行白鹭上青天。\n窗含西岭千秋雪，\n门泊东吴万里船。",
      "表情": "🐦"
    },
    {
      "ID": "poem-zengwanglun",
      "作者": "李白",
      "名称": "赠汪伦",
      "启用": true,
      "模块": "古诗花园",
      "正文": "李白乘舟将欲行，\n忽闻岸上踏歌声。\n桃花潭水深千尺，\n不及汪伦送我情。",
      "表情": "🚣"
